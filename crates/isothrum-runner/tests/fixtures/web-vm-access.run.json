{
  "$schema": "https://raw.githubusercontent.com/isoloom/isoloom/main/schemas/run-manifest-v1.schema.json",
  "manifest_version": 1,
  "generator": {
    "name": "isoloom",
    "version": "1.0.9"
  },
  "environment": {
    "name": "web-vm",
    "instance": null,
    "message": "The page answers at http://localhost:${published.web.web}/."
  },
  "target": "vagrant",
  "driver": "vagrant",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "vagrant",
      "probe": [
        "vagrant",
        "--version"
      ],
      "min_version": "2.4.0"
    },
    {
      "name": "virtualbox",
      "probe": [
        "VBoxManage",
        "--version"
      ],
      "providers": [
        "virtualbox"
      ]
    },
    {
      "name": "vmware",
      "probe": [
        "vmrun",
        "list"
      ],
      "providers": [
        "vmware_desktop"
      ]
    },
    {
      "name": "parallels",
      "probe": [
        "prlctl",
        "--version"
      ],
      "hosts": [
        "macos"
      ],
      "providers": [
        "parallels"
      ]
    },
    {
      "name": "libvirt",
      "probe": [
        "virsh",
        "--version"
      ],
      "hosts": [
        "linux"
      ],
      "providers": [
        "libvirt"
      ]
    },
    {
      "name": "qemu",
      "probe": [
        "qemu-img",
        "--version"
      ],
      "providers": [
        "qemu"
      ]
    }
  ],
  "identity": {
    "vagrant": {
      "providers": [
        {
          "id": "virtualbox",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "vmware_desktop",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-desktop",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "hyperv",
          "hosts": [
            "windows"
          ],
          "elevation": "hyperv",
          "refusal": null
        },
        {
          "id": "parallels",
          "hosts": [
            "macos"
          ],
          "plugin": "vagrant-parallels",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "libvirt",
          "hosts": [
            "linux"
          ],
          "plugin": "vagrant-libvirt",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "qemu",
          "hosts": [
            "linux",
            "macos"
          ],
          "plugin": "vagrant-qemu",
          "elevation": "none",
          "refusal": null
        },
        {
          "id": "vmware_esxi",
          "hosts": [
            "linux",
            "macos",
            "windows"
          ],
          "plugin": "vagrant-vmware-esxi",
          "elevation": "none",
          "remote": true,
          "refusal": null
        }
      ],
      "dotfile": "${run.state_dir}/vagrant"
    }
  },
  "params": [
    {
      "name": "ISOLOOM_HYPERV_SWITCH",
      "description": "The Hyper-V virtual switch each VM's first adapter (Vagrant's connection, and the internet) goes on.",
      "default": "Default Switch",
      "hosts": [
        "windows"
      ],
      "providers": [
        "hyperv"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_HYPERV_SWITCH",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_PUBLISH_FIXED",
      "description": "Set: each published port takes its own `publish` number on the host, instead of a free one.",
      "values": [
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_PUBLISH_FIXED",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_SSH_PROXY_COMMAND",
      "description": "The command Vagrant's SSH to the VMs goes through (an SSH `ProxyCommand`), when this computer can't reach them directly; unset, it connects straight to them.",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_SSH_PROXY_COMMAND",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTNAME",
      "description": "The ESXi host.",
      "required": true,
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_HOSTPORT",
      "description": "Its SSH port.",
      "default": "22",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_HOSTPORT",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_USERNAME",
      "description": "The ESXi user.",
      "default": "root",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_USERNAME",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_DATASTORE",
      "description": "The datastore the VMs' disks go on (default: ESXi's first).",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_DATASTORE",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ESXI_VIRTUAL_NETWORK",
      "description": "Port groups, comma-separated: the management network, then one per environment network.",
      "default": "VM Network",
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_VIRTUAL_NETWORK",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "VAGRANT_HOST_ARCHITECTURE",
      "description": "The architecture Vagrant picks each box's build for: the ESXi host's (x86-64), not this computer's.",
      "default": "amd64",
      "values": [
        "amd64"
      ],
      "providers": [
        "vmware_esxi"
      ],
      "set_by": "runner",
      "deliver": [
        {
          "via": "env",
          "var": "VAGRANT_HOST_ARCHITECTURE",
          "steps": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-user"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "DEMO_SECRET",
      "kind": "input",
      "required": false,
      "sensitive": true,
      "machines": [
        "web"
      ],
      "default": "",
      "deliver": [
        {
          "via": "env",
          "var": "DEMO_SECRET",
          "steps": [
            "up",
            "provision",
            "provision-machine"
          ]
        }
      ]
    },
    {
      "name": "ESXI_PASSWORD",
      "kind": "connection",
      "required": true,
      "sensitive": true,
      "providers": [
        "vmware_esxi"
      ],
      "deliver": [
        {
          "via": "env",
          "var": "ESXI_PASSWORD",
          "steps": [
            "*"
          ]
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.61.0.0/24",
      "internet": true,
      "native": "isoloom-web-vm-lab"
    }
  ],
  "machines": [
    {
      "name": "web",
      "role": "member",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 768
      },
      "addresses": {
        "lab": "10.61.0.10"
      },
      "native": {
        "vagrant": "web",
        "vm_names": {
          "virtualbox": "web-vm - web",
          "vmware_desktop": "web-vm - web",
          "hyperv": "web-vm-web",
          "parallels": "web-vm - web",
          "libvirt": "web-vm_web",
          "utm": "web-vm - web",
          "vmware_esxi": "web-vm-web"
        },
        "boot_digest": "sha256:3c9c85001389ea1b9c2f855d99043eac2dcf39637096bdbceccb5b6e44acce59"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "ephemeral",
            "preferred": 8086,
            "address": "127.0.0.1"
          }
        }
      ],
      "consoles": [
        {
          "providers": [
            "virtualbox"
          ],
          "protocol": "rdp",
          "source": {
            "from": "vrde"
          },
          "note": "on only when the Oracle VM VirtualBox Extension Pack is installed as the VM boots (VirtualBox has no remote display server without it)"
        },
        {
          "providers": [
            "vmware_desktop"
          ],
          "protocol": "vnc",
          "source": {
            "from": "runner"
          }
        },
        {
          "providers": [
            "hyperv"
          ],
          "protocol": "none",
          "note": "Hyper-V has no VNC or remote display server of its own; a Windows machine's own Remote Desktop is the way, when the spec opens its port"
        },
        {
          "providers": [
            "parallels"
          ],
          "protocol": "none",
          "note": "Isoloom sets up no graphical console on Parallels Desktop (its VNC server stays off)"
        },
        {
          "providers": [
            "libvirt"
          ],
          "protocol": "vnc",
          "source": {
            "from": "libvirt"
          }
        },
        {
          "providers": [
            "qemu"
          ],
          "protocol": "vnc",
          "source": {
            "from": "qemu_monitor"
          }
        },
        {
          "providers": [
            "vmware_esxi"
          ],
          "protocol": "none",
          "note": "an ESXi VM's console goes through ESXi's own API (a WebMKS ticket), which Isoloom doesn't use"
        }
      ]
    },
    {
      "name": "user",
      "role": "access",
      "os": "debian-12",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "lab": "10.61.0.99"
      },
      "on_demand": true,
      "native": {
        "vagrant": "user",
        "vm_names": {
          "virtualbox": "web-vm - user",
          "vmware_desktop": "web-vm - user",
          "hyperv": "web-vm-user",
          "parallels": "web-vm - user",
          "libvirt": "web-vm_user",
          "utm": "web-vm - user",
          "vmware_esxi": "web-vm-user"
        },
        "boot_digest": "sha256:3c7ecfb4f03eefe734507ec21fdaecc4b3b1c294181ee45ffb5436e53cfa2eb6"
      },
      "consoles": [
        {
          "providers": [
            "virtualbox"
          ],
          "protocol": "rdp",
          "source": {
            "from": "vrde"
          },
          "note": "on only when the Oracle VM VirtualBox Extension Pack is installed as the VM boots (VirtualBox has no remote display server without it)"
        },
        {
          "providers": [
            "vmware_desktop"
          ],
          "protocol": "vnc",
          "source": {
            "from": "runner"
          }
        },
        {
          "providers": [
            "hyperv"
          ],
          "protocol": "none",
          "note": "Hyper-V has no VNC or remote display server of its own; a Windows machine's own Remote Desktop is the way, when the spec opens its port"
        },
        {
          "providers": [
            "parallels"
          ],
          "protocol": "none",
          "note": "Isoloom sets up no graphical console on Parallels Desktop (its VNC server stays off)"
        },
        {
          "providers": [
            "libvirt"
          ],
          "protocol": "vnc",
          "source": {
            "from": "libvirt"
          }
        },
        {
          "providers": [
            "qemu"
          ],
          "protocol": "vnc",
          "source": {
            "from": "qemu_monitor"
          }
        },
        {
          "providers": [
            "vmware_esxi"
          ],
          "protocol": "none",
          "note": "an ESXi VM's console goes through ESXi's own API (a WebMKS ticket), which Isoloom doesn't use"
        }
      ]
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "reconcile",
        "note": "Clearing the state of a run on another provider, if any…",
        "action": "vagrant.reconcile_provider"
      },
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "up",
        "note": "Building the environment's VMs (Windows machines take a while)…",
        "argv": [
          "vagrant",
          "up",
          "--provider",
          "${run.provider}"
        ],
        "timeout_s": 21600
      }
    ],
    "down": [
      {
        "id": "destroy",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 1800,
        "when": "always"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state"
      }
    ],
    "park": {
      "pause": [
        {
          "id": "suspend",
          "argv": [
            "vagrant",
            "suspend",
            "web",
            "user"
          ],
          "timeout_s": 1800
        }
      ],
      "shutdown": [
        {
          "id": "halt",
          "argv": [
            "vagrant",
            "halt"
          ],
          "timeout_s": 1800
        }
      ]
    },
    "resume": [
      {
        "id": "discard-saved",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "resume",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}",
          "web",
          "user"
        ],
        "timeout_s": 3600,
        "failure": "tolerate"
      },
      {
        "id": "discard-cut-off",
        "action": "vagrant.discard_aborted_saved",
        "failure": "tolerate",
        "providers": [
          "virtualbox"
        ]
      },
      {
        "id": "boot",
        "argv": [
          "vagrant",
          "up",
          "--no-provision",
          "--provider",
          "${run.provider}",
          "web",
          "user"
        ],
        "timeout_s": 3600
      }
    ],
    "provision": {
      "all": [
        {
          "id": "provision",
          "argv": [
            "vagrant",
            "provision",
            "web",
            "user"
          ],
          "timeout_s": 7200
        }
      ],
      "machine": [
        {
          "id": "provision-machine",
          "argv": [
            "vagrant",
            "provision",
            "${machine}"
          ],
          "timeout_s": 7200
        }
      ]
    },
    "status": {
      "id": "status",
      "argv": [
        "vagrant",
        "status",
        "--machine-readable"
      ],
      "timeout_s": 25,
      "provider_timeout_s": {
        "vmware_esxi": 120
      }
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "up",
      "means": "every VM booted and ran its provisioners, the controller's playbooks included"
    },
    {
      "kind": "machines_running",
      "machines": [
        "web",
        "user"
      ]
    }
  ],
  "outputs": [
    {
      "name": "web__web",
      "description": "web's web (port 80).",
      "role": "entry",
      "sensitive": false,
      "format": "http://${host.web}:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "web",
        "port": "web"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "user",
        "from": "from user",
        "checks": [
          {
            "name": "http://web/ from user",
            "kind": "http",
            "wait_s": 120,
            "derived": false
          },
          {
            "name": "web:80 from user",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-user",
          "argv": [
            "vagrant",
            "provision",
            "user",
            "--provision-with",
            "checks"
          ],
          "timeout_s": 240
        }
      }
    ],
    "teardown": []
  },
  "recovery": {
    "stale_markers": [
      "verr_already_exists",
      "could not rename",
      "is locked",
      "different provider",
      "single provider at a time"
    ],
    "steps": [
      {
        "id": "destroy",
        "note": "Clearing what an earlier run left, then starting again…",
        "argv": [
          "vagrant",
          "destroy",
          "--force"
        ],
        "timeout_s": 180,
        "when": "always",
        "failure": "tolerate"
      },
      {
        "id": "orphans",
        "action": "vagrant.remove_orphans",
        "when": "always",
        "failure": "tolerate",
        "providers": [
          "virtualbox",
          "parallels"
        ]
      },
      {
        "id": "reset",
        "action": "vagrant.reset_state",
        "when": "always"
      }
    ],
    "retries": 1
  }
}
