#!/bin/sh
# pre-commit: no staged file over 5 MB unless Git LFS holds it (the pointer is what's committed
# then), and the staged files are formatted (repo.sh's format_staged: the formatters this
# repository uses, over the staged files only, so it takes a moment). With
# `git config hooks.regenerate true` (opt-in: it builds), the generated files are written again
# (regenerate) and a commit that would leave one stale is refused until it is staged.
# shellcheck source-path=SCRIPTDIR
set -u
HOOK=pre-commit
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"
# shellcheck source=repo.sh
. "$(dirname "$0")/repo.sh"

limit=$((5 * 1024 * 1024))
big=$(staged_files | while IFS= read -r f; do
  size=$(git cat-file -s ":$f") || continue
  [ "$size" -gt "$limit" ] || continue
  # No case here: bash 3.2 (macOS's sh) misparses a pattern's ")" inside "$(...)".
  if git check-attr filter -- "$f" | grep -q ': filter: lfs$'; then continue; fi
  printf '%s (%s MB)\n' "$f" $((size / 1024 / 1024))
done)
if [ -n "$big" ]; then
  refuse "a staged file is over 5 MB and Git LFS doesn't hold it (git lfs track it, or leave it out):" "$big"
fi

files=$(staged_files)
[ -z "$files" ] || format_staged "$files"

if [ "$(git config --bool hooks.regenerate)" = true ]; then
  "$(dirname "$0")/regenerate" >/dev/null || refuse "the generated files couldn't be written: .githooks/regenerate says why"
  # shellcheck disable=SC2086 # one path a word: the paths have no spaces
  changed=$(git diff --name-only -- $GENERATED)
  [ -z "$changed" ] || refuse "a generated file was stale and is written again: review it, stage it, commit again" "$changed"
fi
exit 0
